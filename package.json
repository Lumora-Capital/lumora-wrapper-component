{
	"name": "@lumora/lumora-wrapper-component",
	"private": false,
	"version": "2.0.0",
	"type": "module",
	"main": "./dist/lumora-wrapper-component.umd.js",
	"module": "./dist/lumora-wrapper-component.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/lumora-wrapper-component.es.js",
			"require": "./dist/lumora-wrapper-component.umd.js"
		},
		"./styles.css": "./dist/lumora-wrapper.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite --config vite.demo.config.ts",
		"build": "NODE_ENV=production tsc --project tsconfig.build.json && NODE_ENV=production vite build && npm run build:css",
		"build:demo": "vite build --config vite.demo.config.ts",
		"preview": "vite preview --config vite.demo.config.ts",
		"typecheck": "tsc --project tsconfig.app.json --noEmit",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:css": "tailwindcss -i src/lib/styles.css -o dist/lumora-wrapper.css --minify"
	},
	"peerDependencies": {
		"axios": "^1.12.2",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@tailwindcss/cli": "4.3.3",
		"@tailwindcss/postcss": "4.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.7.2",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.0.3",
		"baseline-browser-mapping": "^2.10.7",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"prettier": "^3.6.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "4.3.3",
		"ts-jest": "^29.4.4",
		"tw-animate-css": "1.4.0",
		"typescript": "^5.0.2",
		"vite": "^4.4.5",
		"vite-plugin-dts": "^3.5.3"
	},
	"dependencies": {
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.66.0",
		"radix-ui": "1.8.1",
		"tailwind-merge": "3.7.0"
	},
	"sideEffects": [
		"*.css"
	]
}
